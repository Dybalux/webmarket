SECRET_KEY="generatesecretkey"
DATABASE_URL="mongodb://mongo_bebidas:27017"
DATABASE_NAME="bebidas_db"

# ACCESS TOKEN MERCADOPAGO
MERCADOPAGO_ACCESS_TOKEN="secretkey_mp"
MERCADOPAGO_PUBLIC_KEY="secretkey_mp"
MERCADOPAGO_WEBHOOK_SECRET="webhook_secret_key_from_mp_panel"
# Esta URL la actualizaremos con ngrok para probar el webhook
WEBHOOK_BASE_URL="http://localhost:8000"
# URL del frontend para redirecciones después del pago
FRONTEND_URL="http://localhost:3000"

# URL de conexión para Redis
REDIS_URL="redis://redis_bebidas:6379"

# --- CONFIGURACIÓN DE EMAIL (Resend) ---
# Los emails se envían a todos los usuarios con rol "admin"
# Obtén tu API Key en: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"  # Usa este email para testing, o tu propio dominio
EMAIL_ENABLED=false  # Cambiar a true cuando configures Resend

ENV="development"
NGROK_AUTH_TOKEN="tokenngrok"