# =============================================================================
# webmarket environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Variables marked REQUIRED have no default value and the app will fail to
# start without them. Variables marked OPTIONAL have a default in config.py.
# NEVER commit `.env` — it is in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# JWT authentication
# -----------------------------------------------------------------------------

# REQUIRED. Long random string used to sign JWT tokens.
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-a-long-random-string

# Algorithm for JWT signing. Default: HS256
ALGORITHM=HS256

# Access token lifetime in minutes. Default: 30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days. Default: 7
REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------

# REQUIRED. MongoDB connection string.
# Local dev: mongodb://localhost:27017
# Docker compose service: mongodb://mongo:27017
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
DATABASE_URL=mongodb://localhost:27017

# REQUIRED. Database name. Default in dev: webmarket_dev
DATABASE_NAME=webmarket_dev


# -----------------------------------------------------------------------------
# Redis (rate limiting, FastAPILimiter)
# -----------------------------------------------------------------------------

# OPTIONAL. Default: redis://localhost:6379
# Docker compose service: redis://redis:6379
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Mercado Pago (payments)
# -----------------------------------------------------------------------------

# OPTIONAL. Get from https://www.mercadopago.com.ar/developers/panel
# Leave empty in dev if not testing payments.
MERCADOPAGO_ACCESS_TOKEN=

# OPTIONAL. Public key for client-side checkout.
MERCADOPAGO_PUBLIC_KEY=

# OPTIONAL. Webhook signing secret for validating MP callbacks.
MERCADOPAGO_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# URLs (webhooks, CORS, frontend)
# -----------------------------------------------------------------------------

# OPTIONAL. Base URL for MP webhooks. Default: http://localhost:8000
# Dev (Cloudflare Tunnel): https://api.altotrago.com
# Prod: https://api.yourdomain.com
WEBHOOK_BASE_URL=http://localhost:8000

# OPTIONAL. Frontend URL for redirects after payment. Default: http://localhost:3000
# Dev: https://altotrago.com (or http://localhost:3000 for local)
# Prod: https://yourdomain.com
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------

# OPTIONAL. API key from https://resend.com/api-keys
RESEND_API_KEY=

# OPTIONAL. Verified sender email (must be in your Resend account).
RESEND_FROM_EMAIL=

# OPTIONAL. Toggle email sending. Default: false
# Set to true in prod, false in dev unless testing.
EMAIL_ENABLED=false


# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------

# OPTIONAL. One of: development, production, test. Default: development
ENV=development
